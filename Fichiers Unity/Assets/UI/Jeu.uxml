<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Page" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="Visuel" style="flex-grow: 1; background-color: rgb(136, 115, 48); width: 80%; background-image: url(&quot;project://database/Assets/UI/VueScene_RT.renderTexture?fileID=8400000&amp;guid=cabc3a504080a77499b86c8b62aa2901&amp;type=2#VueScene_RT&quot;);"/>
        <ui:VisualElement name="Navbar" style="flex-grow: 1; flex-direction: column; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgb(171, 181, 186); width: 20%; align-items: center; justify-content: space-around; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;">
            <ui:VisualElement name="Vitesse" style="flex-grow: 1; align-items: center; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
                <ui:Button text="" icon-image="project://database/Assets/Images/Patins.png?fileID=2800000&amp;guid=3b836ade39a45db43be416b2920bd28b&amp;type=3#Patins" name="Patins" focusable="false" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 100%; height: 50%; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;"/>
                <ui:Label text="Restant : 6" name="LabelVitesseRes" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 20%;"/>
                <ui:Label text="En jeu : 1/4" name="PatinsEnJeu" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; font-size: 20%;"/>
            </ui:VisualElement>
            <ui:VisualElement name="SacDeBombe" style="flex-grow: 1; align-items: center;">
                <ui:Button text="" icon-image="project://database/Assets/Images/Sac.png?fileID=2800000&amp;guid=060eccb8037b64f4ab3c113663cd1348&amp;type=3#Sac" name="Sac" focusable="false" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 100%; height: 50%; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); background-color: rgba(188, 188, 188, 0);"/>
                <ui:Label text="Restant : 6" name="LabelSacRes" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; font-size: 20%;"/>
