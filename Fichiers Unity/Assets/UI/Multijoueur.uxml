<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Page" style="flex-grow: 1; flex-direction: row; background-color: rgb(79, 96, 107); width: 100%; height: 100%;">
        <ui:VisualElement name="ConteneurPrincipal" style="flex-grow: 1; flex-direction: row; display: flex;">
            <ui:VisualElement name="Mode_Solo" style="flex-grow: 1; justify-content: center; align-items: center; width: 50%;">
                <ui:Button text="" name="Host" style="background-color: rgb(61, 92, 180); border-left-color: rgb(122, 122, 122); border-right-color: rgb(122, 122, 122); border-top-color: rgb(122, 122, 122); border-bottom-color: rgb(122, 122, 122); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; align-items: center; height: 60%;">
                    <ui:Label text="Créer un combat" style="color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 30%; top: 0%; height: 40%; -unity-text-align: middle-left;"/>
                    <ui:Image source="project://database/Assets/Images/1bombe.png?fileID=2800000&amp;guid=f9aa33659c5a08d45949365353467859&amp;type=3#1bombe" scale-mode="ScaleToFit" style="rotate: 24deg; height: 60%; bottom: 7%;"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="Mode_Multijoueur" style="flex-grow: 1; align-items: center; justify-content: center; width: 50%;">
                <ui:Button text="" name="Client" style="border-left-color: rgb(122, 122, 122); border-right-color: rgb(122, 122, 122); border-top-color: rgb(122, 122, 122); border-bottom-color: rgb(122, 122, 122); background-color: rgb(180, 61, 61); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; height: 60%; align-items: center;">
                    <ui:Label text="Rejoindre un combat" style="color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 30%; top: 0%; height: 40%; -unity-text-align: middle-center;"/>
                    <ui:Image source="project://database/Assets/Images/2bombes.png?fileID=2800000&amp;guid=a695beb91fb21fa4ab709fdfa7190009&amp;type=3#2bombes" scale-mode="ScaleAndCrop" uv="0,0,1,1.24" style="height: 54%; width: 85%; bottom: 7%;"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:Button text="Commandes" name="Commandes" style="position: absolute; bottom: 5%; left: 40%; right: auto; width: 20%; height: 10%; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; background-color: rgb(51, 51, 51); color: rgb(255, 255, 255); font-size: 20%; -unity-font-style: bold;"/>
        </ui:VisualElement>
        <ui:VisualElement name="ConteneurHost" style="flex-grow: 1; align-items: center; justify-content: space-around; display: none;">
            <ui:Label text="Code : " name="TexteCode" style="width: 30%; height: 15%; font-size: 50%; -unity-text-align: middle-left; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); background-color: rgb(30, 29, 29); color: rgb(255, 255, 255); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2%; padding-right: 2%; padding-bottom: 2%; padding-left: 2%;"/>
            <ui:Label text="Joueurs connectés : " name="ListeJoueurs" style="height: 50%; width: 50%; font-size: 50%; border-top-left-radius: 25px; border-top-right-radius: 25px; border-bottom-right-radius: 25px; border-bottom-left-radius: 25px; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-left-color: rgb(147, 147, 147); border-right-color: rgb(147, 147, 147); border-top-color: rgb(147, 147, 147); border-bottom-color: rgb(147, 147, 147); background-color: rgb(186, 186, 186); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2%; padding-right: 2%; padding-bottom: 2%; padding-left: 2%;"/>
            <ui:Button text="Commencer" name="BoutonDemarrer" style="width: 20%; height: 15%; font-size: 50%; -unity-font-style: bold; border-top-left-radius: 25px; border-top-right-radius: 25px; border-bottom-right-radius: 25px; border-bottom-left-radius: 25px; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="ConteneurClient" style="flex-grow: 1; display: none; align-items: center; justify-content: space-around; width: 100%; height: 100%; align-self: auto; align-content: flex-start;">
            <ui:TextField label="Pseudo" placeholder-text="Bomberman X" name="ChampPseudo" style="font-size: 50%; height: 10%; width: 50%; -unity-text-align: middle-left;"/>
            <ui:TextField label="Code" placeholder-text="CX6ip0" name="ChampCode" style="width: 50%; height: 10%; font-size: 50%; -unity-text-align: middle-left;"/>
            <ui:Button text="Rejoindre" name="BoutonRejoindre" style="width: 20%; height: 15%; font-size: 50%; -unity-font-style: bold; border-top-left-radius: 25px; border-top-right-radius: 25px; border-bottom-right-radius: 25px; border-bottom-left-radius: 25px; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px;"/>
            <ui:VisualElement name="Attente" style="flex-grow: 0; position: absolute; height: 100%; width: 100%; flex-direction: column; background-color: rgba(47, 42, 42, 0.69); top: 0; left: 0; align-items: center; justify-content: center; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; display: none;">
                <ui:VisualElement style="flex-grow: 0; width: 50%; height: 50%; background-color: rgb(0, 0, 0); align-items: center; justify-content: center; border-top-left-radius: 25px; border-top-right-radius: 25px; border-bottom-right-radius: 25px; border-bottom-left-radius: 25px;">
                    <ui:Label text="Vous avez rejoin le groupe.&#10;Patientez en attendant le démarrage de la partie." name="TexteAttente" style="color: rgb(255, 255, 255); font-size: 50%; white-space: normal; -unity-text-align: upper-center;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
